  <entity00126380:DescriptionOfDilutedEarningsLossPerShare contextRef="CFY2023dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember" xml:lang="ko">나. 희석주당순이익

