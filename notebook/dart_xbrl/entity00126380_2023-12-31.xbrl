  <ifrs-full:ProportionOfOwnershipInterestsHeldByNoncontrollingInterests contextRef="CFY2023dFY_ifrs-full_ConsolidatedAndSeparateFinancialStatementsAxis_ifrs-full_ConsolidatedMember_ifrs-full_SignificantInvestmentsInSubsidiariesAxis_entity00126380_SamsungDisplayCoLtdAndItsSubsidiariesMemberOfSubsidiariesWithMaterialNonControllingInterestsMemberOfDisclosureOfSubsidiariesWithMaterialNonControllingInterestsAbstractTableOfMember" unitRef="PURE" decimals="INF">0.152</ifrs-full:ProportionOfOwnershipInterestsHeldByNoncontrollingInterests>
